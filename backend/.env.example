# Router credentials for ZTE F670L / IndiHome Access Control.
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env.
NETDASH_ROUTER_USER=admin
NETDASH_ROUTER_PASS=change-me
NETDASH_ROUTER_URL=http://192.168.1.1

# Optional runtime overrides.
# NETDASH_PASSWORD=netdash
# NETDASH_PORT=8777
# NETDASH_HOST=127.0.0.1
# NETDASH_DATA=/absolute/path/to/backend/data
