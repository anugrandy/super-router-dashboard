{
  "name": "super-router-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "AN Telemetry — network dashboard, device manager, and router access control",
  "type": "module",
  "bin": {
    "anrouter": "./bin/anrouter.js"
  },
  "scripts": {
    "anrouter": "node ./bin/anrouter.js",
    "pm2:start": "pm2 start run-pm2.js --name Dashboard-Router",
    "pm2:prod": "pm2 start run-pm2.js --name Dashboard-Router -- --prod",
    "build": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "open": "^11.0.4",
    "prompts": "^2.4.2"
  }
}
